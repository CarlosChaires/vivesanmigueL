<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Itinerario Rápido · Vive San Miguel</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<style>
  :root {
    --cantera: #b86b5c;
    --noche: #2c2422;
    --fondo: #fdf8f6;
    --blanco: #ffffff;
    --borde: rgba(184, 107, 92, 0.2);
  }
  body {
    font-family: 'Outfit', system-ui, sans-serif;
    background: var(--fondo);
    color: var(--noche);
    margin: 0; padding: 20px;
  }
  .card {
    background: var(--blanco);
    max-width: 600px;
    margin: 40px auto;
    padding: 30px;
    border-radius: 16px;
    border: 1px solid var(--borde);
    box-shadow: 0 10px 30px rgba(0,0,0,0.04);
  }
  h2 { font-family: 'Cormorant Garamond', serif; font-size: 2rem; color: var(--cantera); margin-top: 0; }
  label { display: block; font-size: 0.8rem; font-weight: 700; text-transform: uppercase; margin: 15px 0 5px; }
  select, button {
    width: 100%;
    padding: 12px;
    border-radius: 8px;
    border: 1px solid var(--borde);
    font-size: 1rem;
    outline: none;
  }
  select { background: #fff; margin-bottom: 20px; }
  button {
    background: var(--cantera);
    color: white;
    font-weight: bold;
    cursor: pointer;
    border: none;
    transition: background 0.3s;
  }
  button:hover { background: #8f4f42; }
  .resultado {
    margin-top: 25px;
    background: #faf4f2;
    padding: 20px;
    border-radius: 10px;
    display: none;
  }
  .resultado.activo { display: block; }
  .item { margin-bottom: 12px; font-size: 0.95rem; }
  .item strong { color: var(--cantera); }
</style>
</head>
<body>

<div class="card">
  <h2>Arma tu Viaje al Instante</h2>
  <p>Selecciona tu plan ideal y el sistema te genera un recorrido automático guardado en tu sesión.</p>

  <label>Tipo de Experiencia</label>
  <select id="tipoViaje">
    <option value="enoturismo">🍷 Ruta de Viñedos y Cavas</option>
    <option value="romance">✨ Escapada Romántica</option>
    <option value="cultura">🏛️ Historia y Arquitectura Colonial</option>
  </select>

  <button onclick="crearItinerario()">Generar Itinerario</button>

  <div class="resultado" id="cajaResultado">
    <h3 id="tituloPlan" style="margin-top:0; color:var(--noche);"></h3>
    <div id="detallePlan"></div>
  </div>
</div>

<script>
  const planes = {
    enoturismo: [
      { hora: "10:00 AM", texto: "Visita guiada y cata de bienvenida en Viñedos San Lucas." },
      { hora: "02:00 PM", texto: "Comida maridaje con menú mediterráneo en el viñedo." },
      { hora: "06:00 PM", texto: "Atardecer y recorrido por la cava subterránea de Vinícola Toyan." }
    ],
    romance: [
      { hora: "11:00 AM", texto: "Paseo tranquilo por los callejones históricos del centro." },
      { hora: "02:30 PM", texto: "Comida íntima en terraza con vista panorámica a la Parroquia." },
      { hora: "07:00 PM", texto: "Cena a la luz de las velas en un restaurante boutique." }
    ],
    cultura: [
      { hora: "09:30 AM", texto: "Fotografía y recorrido arquitectónico por la Parroquia de San Miguel Arcángel." },
      { hora: "12:00 PM", texto: "Visita cultural al Museo Casa de Allende." },
      { hora: "04:00 PM", texto: "Recorrido por talleres tradicionales de latón y cantera." }
    ]
  };

  function crearItinerario() {
    const tipo = document.getElementById('tipoViaje').value;
    const seleccion = planes[tipo];
    
    // Guardamos en localStorage para que el navegador lo recuerde
    localStorage.setItem('ultimo_itinerario', JSON.stringify(seleccion));

    let html = "";
    seleccion.forEach(act => {
      html += `<div class="item"><strong>${act.hora}:</strong> ${act.texto}</div>`;
    });

    document.getElementById('tituloPlan').innerText = "Tu Itinerario Personalizado:";
    document.getElementById('detallePlan').innerHTML = html;
    document.getElementById('cajaResultado').classList.add('activo');
  }
</script>

</body>
</html>
