<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Diseñador de Itinerarios · Vive San Miguel</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<style>
  :root {
    --cantera: #b86b5c;
    --cantera-dark: #8f4f42;
    --stone: #2c2422;
    --muted: #6b5e5a;
    --paper: #fdf8f6;
    --surface: #ffffff;
    --border: rgba(184, 107, 92, 0.18);
    --shadow: 0 20px 40px -12px rgba(44, 36, 34, 0.08);
  }
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: 'Outfit', sans-serif;
    background: var(--paper);
    color: var(--stone);
    line-height: 1.6;
    padding: 2rem 1rem;
  }
  .wrap { max-width: 800px; margin: 0 auto; }
  header { text-align: center; margin-bottom: 2.5rem; }
  header h1 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 2.5rem;
    color: var(--stone);
    margin-bottom: 0.5rem;
  }
  header p { color: var(--muted); font-size: 0.95rem; }
  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 2.5rem;
    box-shadow: var(--shadow);
    margin-bottom: 2rem;
  }
  .input-group { margin-bottom: 1.5rem; }
  label {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--muted);
    margin-bottom: 0.5rem;
  }
  select {
    width: 100%;
    padding: 0.9rem 1rem;
    border: 1px solid var(--border);
    border-radius: 12px;
    font-family: 'Outfit', sans-serif;
    font-size: 0.95rem;
    background: var(--paper);
    color: var(--stone);
    outline: none;
  }
  select:focus { border-color: var(--cantera); background: #fff; }
  .btn-main {
    background: var(--cantera);
    color: #fff;
    border: none;
    width: 100%;
    padding: 1rem;
    border-radius: 30px;
    font-weight: 700;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    cursor: pointer;
    transition: background 0.3s ease;
  }
  .btn-main:hover { background: var(--cantera-dark); }
  .result-box {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 2.5rem;
    box-shadow: var(--shadow);
    display: none;
  }
  .result-box.active { display: block; }
  .result-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.8rem;
    color: var(--cantera-dark);
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.8rem;
  }
  .timeline-item {
    display: flex;
    gap: 1.2rem;
    margin-bottom: 1.2rem;
    padding-bottom: 1.2rem;
    border-bottom: 1px dashed var(--border);
  }
  .timeline-item:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }
  .time {
    background: var(--paper);
    color: var(--cantera);
    font-weight: 700;
    font-size: 0.85rem;
    padding: 0.4rem 0.8rem;
    border-radius: 8px;
    height: fit-content;
    white-space: nowrap;
    border: 1px solid var(--border);
  }
  .desc h4 { font-size: 1.05rem; font-weight: 600; margin-bottom: 0.2rem; color: var(--stone); }
  .desc p { font-size: 0.9rem; color: var(--muted); }
  .nav-back {
    display: inline-block;
    margin-bottom: 1.5rem;
    color: var(--cantera);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  .nav-back:hover { text-decoration: underline; }
</style>
</head>
<body>
  <div class="wrap">
    <a href="sitiosdeinteres.html" class="nav-back"><i class="fas fa-arrow-left"></i> Volver a Sitios</a>
    <header>
      <h1>Diseñador de Itinerarios</h1>
      <p>Crea tu recorrido personalizado por San Miguel de Allende al instante.</p>
    </header>

    <div class="card">
      <div class="input-group">
        <label>Selecciona tu Experiencia</label>
        <select id="estiloViaje">
          <option value="enoturismo">🍷 Ruta Enológica y Viñedos</option>
          <option value="romance">✨ Escapada Romántica & Lujo</option>
          <option value="cultura">🏛️ Historia, Arte y Arquitectura</option>
        </select>
      </div>
      <button class="btn-main" onclick="generarItinerario()">Generar Itinerario</button>
    </div>

    <div class="result-box" id="cajaResultado">
      <h3 class="result-title" id="tituloResultado">Tu Itinerario</h3>
      <div id="contenidoItinerario"></div>
    </div>
  </div>

<script>
  const itinerariosDB = {
    enoturismo: [
      { hora: "10:00 AM", titulo: "Bienvenida en Viñedos San Lucas", desc: "Recorrido por los campos de lavanda, olivos y cata de bienvenida." },
      { hora: "02:00 PM", titulo: "Comida en Restaurante Vinícola", desc: "Menú mediterráneo de tiempos maridado con etiquetas selectas." },
      { hora: "05:00 PM", titulo: "Atardecer en Vinícola Toyan", desc: "Visita a la cava subterránea profunda y degustación orgánica." }
    ],
    romance: [
      { hora: "11:00 AM", titulo: "Paseo Callejero al Atardecer", desc: "Caminata romántica por los mesones históricos y callejones empedrados." },
      { hora: "02:30 PM", titulo: "Comida Íntima con Vista", desc: "Almuerzo en terraza panorámica frente a la Parroquia." },
      { hora: "07:30 PM", titulo: "Cena de Gala Gourmet", desc: "Cena a la luz de las velas con cocina de autor en el centro." }
    ],
    cultura: [
      { hora: "09:00 AM", titulo: "Parroquia de San Miguel Arcángel", desc: "Contemplación de la icónica fachada neogótica de cantera rosa." },
      { hora: "11:30 AM", titulo: "Museo Casa de Allende", desc: "Recorrido por la cuna histórica del general Ignacio Allende." },
      { hora: "04:00 PM", titulo: "Talleres Artesanales", desc: "Visita a talleres locales de latón, vidrio soplado y cantera tradicional." }
    ]
  };

  function generarItinerario() {
    const tipo = document.getElementById('estiloViaje').value;
    const datos = itinerariosDB[tipo];
    
    let html = "";
    datos.forEach(item => {
      html += `
        <div class="timeline-item">
          <div class="time">${item.hora}</div>
          <div class="desc">
            <h4>${item.titulo}</h4>
            <p>${item.desc}</p>
          </div>
        </div>
      `;
    });

    document.getElementById('contenidoItinerario').innerHTML = html;
    document.getElementById('cajaResultado').classList.add('active');
    document.getElementById('cajaResultado').scrollIntoView({ behavior: 'smooth' });
    
    localStorage.setItem('sma_ultimo_itinerario', JSON.stringify(datos));
  }
</script>
</body>
</html>
